# ==== Ứng dụng ====
APP_ENV=dev              # dev | staging | prod
HTTP_ADDR=:8080
LOG_LEVEL=info
LOG_JSON=false

# Bỏ trống DATABASE_URL để chạy hoàn toàn in-memory (không cần hạ tầng gì).
DATABASE_URL=
# DATABASE_URL=postgres://godrive:godrive@localhost:5432/godrive?sslmode=disable

REDIS_URL=redis://localhost:6379/0
NATS_URL=nats://localhost:4222
MQTT_URL=tcp://localhost:1883

# ==== Bảo mật ====
JWT_SECRET=dev-secret-doi-truoc-khi-len-production
ACCESS_TTL=24h
DEV_AUTH=true            # trả mã OTP trong response — PHẢI đặt false ở production

# ==== Tuân thủ ====
DATA_RESIDENCY=VN        # Nghị định 13/2023: dữ liệu cá nhân lưu trong nước

# ==== Tích hợp bên thứ ba (điền khi triển khai thật) ====
GOONG_API_KEY=
OSRM_URL=http://localhost:5000
FCM_SERVER_KEY=
ZALO_ZNS_APP_ID=
ZALO_ZNS_SECRET=
MOMO_PARTNER_CODE=
ZALOPAY_APP_ID=
VNPAY_TMN_CODE=
EKYC_PROVIDER=fpt        # fpt | vnpt
EINVOICE_PROVIDER=viettel

# ==== Bảng điều khiển vận hành (godrive-admin) ====
# Số điện thoại được phép đăng nhập admin, phân tách bằng dấu phẩy.
# Rỗng = không ai vào được. Quyền quản trị phải cấp tường minh.
ADMIN_PHONES=
